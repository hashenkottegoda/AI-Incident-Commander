# AI Incident Commander — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored
# (see .gitignore) — never commit real secrets. `backend/config.py` loads
# and validates these via pydantic-settings.

# --- Anthropic Claude ---------------------------------------------------

# Required. Claude API access for all agent reasoning/tool calling.
# No default on purpose — the app should fail fast if this is missing.
ANTHROPIC_API_KEY=

# Per-role model IDs. Never hard-code model IDs in code — every agent node
# reads its model from here, so swapping models is a config change, not a
# code change. These models reject `temperature`/`top_p`; steer behavior
# via prompting only.
#
# Values below are BUILD_PLAN.md's current best guess as of the model
# catalog cached 2026-06-24 (Claude Opus 4.8 / Claude Haiku 4.5). Model IDs
# and aliases change — verify against the current Anthropic model catalog
# (https://platform.claude.com/docs/en/about-claude/models/overview) before
# relying on these in a real deployment.
TRIAGE_MODEL=claude-haiku-4-5
INVESTIGATION_MODEL=claude-opus-4-8
RCA_MODEL=claude-opus-4-8

# --- Embeddings ----------------------------------------------------------

# MVP default: local sentence-transformers model, no API key required.
# Keeps `docker compose up && uv run ...` fully reproducible offline.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional production-grade embedding swap (NOT used by the MVP default;
# only read if/when the embedding pipeline is configured to use Voyage AI
# instead of local sentence-transformers). Leave unset/commented for local
# development.
# VOYAGE_API_KEY=

# --- PostgreSQL ------------------------------------------------------------

# SQLAlchemy-style connection URL. Matches docker-compose.yml's dev
# defaults (user/password/db = incident_commander, host localhost, port
# 5432). Also used for LangGraph's Postgres checkpointer.
DATABASE_URL=postgresql+psycopg://incident_commander:incident_commander@localhost:5432/incident_commander

# --- Qdrant ----------------------------------------------------------------

# Matches docker-compose.yml's qdrant service (HTTP port 6333).
QDRANT_URL=http://localhost:6333
